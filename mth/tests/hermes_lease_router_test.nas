; Native NaN16DE regression for independent HERMES leased universes.
; Execute in NaN0S: sh tools/nrun.sh src/nannet/hermes_lease_test.nas 1000000
main:
; Open slot 0: epoch1, lease101, universe501, owner97, node3, until100.
MOVI r1,0
MOVI r2,1
MOVI r3,101
MOVI r4,501
MOVI r5,97
MOVI r6,3
MOVI r7,100
MOVI r8,10
CALL @nhl_open
CMP r3,r0
JMP[NE] @fail
; Local head zero resolves to this lease's independent universe.
MOVI r1,0
MOVI r2,101
MOVI r3,501
MOVI r4,1
MOVI r5,97
MOVI r6,0
MOVI r7,11
CALL @nhl_resolve
CMP r3,r0
JMP[NE] @fail
MOVI r8,501
CMP r1,r8
JMP[NE] @fail
CMP r2,r0
JMP[NE] @fail
MOVI r8,3
CMP r4,r8
JMP[NE] @fail
; Last legal head is 254.
MOVI r1,0
MOVI r2,101
MOVI r3,501
MOVI r4,1
MOVI r5,97
MOVI r6,254
MOVI r7,11
CALL @nhl_resolve
CMP r3,r0
JMP[NE] @fail
MOVI r8,254
CMP r2,r8
JMP[NE] @fail
; Slot 255 is NANNET-only, never a learning head.
MOVI r1,0
MOVI r2,101
MOVI r3,501
MOVI r4,1
MOVI r5,97
MOVI r6,255
MOVI r7,11
CALL @nhl_resolve
MOVI r8,7
CMP r3,r8
JMP[NE] @fail
CMP r1,r0
JMP[NE] @fail
; Cross-lease head access with the wrong owner fails.
MOVI r1,0
MOVI r2,101
MOVI r3,501
MOVI r4,1
MOVI r5,98
MOVI r6,17
MOVI r7,20
CALL @nhl_resolve
MOVI r8,5
CMP r3,r8
JMP[NE] @fail
; Opening another active slot with same lease ID is forbidden.
MOVI r1,1
MOVI r2,1
MOVI r3,101
MOVI r4,502
MOVI r5,98
MOVI r6,4
MOVI r7,200
MOVI r8,20
CALL @nhl_open
MOVI r9,3
CMP r3,r9
JMP[NE] @fail
; Another active lease cannot claim an already-owned universe.
MOVI r1,1
MOVI r2,1
MOVI r3,102
MOVI r4,501
MOVI r5,98
MOVI r6,4
MOVI r7,200
MOVI r8,20
CALL @nhl_open
MOVI r9,3
CMP r3,r9
JMP[NE] @fail
; Two independent universes may share one authenticated NANNET endpoint.
; Distinct lease/universe shares node point 3 in slot 1.
MOVI r1,1
MOVI r2,1
MOVI r3,102
MOVI r4,502
MOVI r5,98
MOVI r6,3
MOVI r7,200
MOVI r8,20
CALL @nhl_open
CMP r3,r0
JMP[NE] @fail
; Active slot may not be overwritten, even with newer epoch.
MOVI r1,0
MOVI r2,2
MOVI r3,103
MOVI r4,503
MOVI r5,97
MOVI r6,5
MOVI r7,250
MOVI r8,20
CALL @nhl_open
MOVI r9,3
CMP r3,r9
JMP[NE] @fail
; Valid renewal extends only the same lease.
MOVI r1,0
MOVI r2,1
MOVI r3,101
MOVI r4,97
MOVI r5,150
MOVI r6,20
CALL @nhl_renew
CMP r3,r0
JMP[NE] @fail
; No shortening or same-deadline renewal.
MOVI r1,0
MOVI r2,1
MOVI r3,101
MOVI r4,97
MOVI r5,140
MOVI r6,20
CALL @nhl_renew
MOVI r9,1
CMP r3,r9
JMP[NE] @fail
; Cross-owner renewal fails.
MOVI r1,0
MOVI r2,1
MOVI r3,101
MOVI r4,98
MOVI r5,200
MOVI r6,20
CALL @nhl_renew
MOVI r9,5
CMP r3,r9
JMP[NE] @fail
; At deadline the old lease expires (not including boundary tick).
MOVI r1,0
MOVI r2,101
MOVI r3,501
MOVI r4,1
MOVI r5,97
MOVI r6,17
MOVI r7,150
CALL @nhl_resolve
MOVI r8,4
CMP r3,r8
JMP[NE] @fail
; Generation one must never reappear after expiry.
MOVI r1,0
MOVI r2,1
MOVI r3,103
MOVI r4,503
MOVI r5,97
MOVI r6,5
MOVI r7,251
MOVI r8,151
CALL @nhl_open
MOVI r9,2
CMP r3,r9
JMP[NE] @fail
; Epoch two may instantiate a NEW universe at the freed slot.
MOVI r1,0
MOVI r2,2
MOVI r3,103
MOVI r4,503
MOVI r5,97
MOVI r6,5
MOVI r7,251
MOVI r8,151
CALL @nhl_open
CMP r3,r0
JMP[NE] @fail
; A stale release must never revoke epoch two.
MOVI r1,0
MOVI r2,1
MOVI r3,101
MOVI r4,97
CALL @nhl_release
MOVI r9,2
CMP r3,r9
JMP[NE] @fail
; Release the current lease, then replay a release.
MOVI r1,0
MOVI r2,2
MOVI r3,103
MOVI r4,97
CALL @nhl_release
CMP r3,r0
JMP[NE] @fail
MOVI r1,0
MOVI r2,2
MOVI r3,103
MOVI r4,97
CALL @nhl_release
MOVI r9,6
CMP r3,r9
JMP[NE] @fail
; Another lease's universe survives the previous lease's revocation.
MOVI r1,1
MOVI r2,102
MOVI r3,502
MOVI r4,1
MOVI r5,98
MOVI r6,17
MOVI r7,151
CALL @nhl_resolve
CMP r3,r0
JMP[NE] @fail
MOVI r9,502
CMP r1,r9
JMP[NE] @fail
MOVI r9,17
CMP r2,r9
JMP[NE] @fail
MOVI r9,3
CMP r4,r9
JMP[NE] @fail
; Invalid network point and invalid expired opening are rejected.
MOVI r1,2
MOVI r2,1
MOVI r3,104
MOVI r4,504
MOVI r5,99
MOVI r6,0
MOVI r7,300
MOVI r8,150
CALL @nhl_open
MOVI r9,1
CMP r3,r9
JMP[NE] @fail
MOVI r1,2
MOVI r2,1
MOVI r3,104
MOVI r4,504
MOVI r5,99
MOVI r6,6
MOVI r7,150
MOVI r8,150
CALL @nhl_open
MOVI r9,4
CMP r3,r9
JMP[NE] @fail
; Out-of-range registry slot cannot wrap to another slot's memory.
MOVI r1,16
MOVI r2,1
MOVI r3,104
MOVI r4,504
MOVI r5,99
MOVI r6,6
MOVI r7,300
MOVI r8,150
CALL @nhl_open
MOVI r9,1
CMP r3,r9
JMP[NE] @fail
JMP @pass
fail:
MOVI r1,72
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,77
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,70
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,73
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,10
PUTC r1
HALT
pass:
MOVI r1,72
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,82
PUTC r1
MOVI r1,77
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,76
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,69
PUTC r1
MOVI r1,32
PUTC r1
MOVI r1,80
PUTC r1
MOVI r1,65
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,83
PUTC r1
MOVI r1,10
PUTC r1
HALT
.include "../nan16/hermes_lease.nas"
