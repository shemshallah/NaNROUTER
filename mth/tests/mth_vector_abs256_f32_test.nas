; MTH vector abs fixture — NaN16 only.
.org 0
JMP @mth_vec_abs_main
.include "../nan16/mth_vector_abs256_f32.nas"

mth_vec_abs_main:
  MOVI r13,1
  MOVI r8,@mth_abs_in
  MOVI r9,@mth_abs_out
  ADD r1,r8,r0
  ADD r2,r9,r0
  CALL @mth_vector_abs256_f32
  MOVI r7,1
  CMP r1,r7
  JMP[NE] @mth_abs_fail
  MOVI r3,0
  MOVI r4,0
  MOVHI r4,0x8000
mth_abs_check:
  ADD r5,r8,r3
  LD r6,r5,0
  BOOL.6 r6,r6,r4
  ADD r5,r9,r3
  LD r5,r5,0
  CMP r5,r6
  JMP[NE] @mth_abs_fail
  ADD r3,r3,r13
  MOVI r7,256
  CMP r3,r7
  JMP[LT] @mth_abs_check
  MOVI r1,@mth_abs_pass
  CALL @mth_abs_puts
  HALT

mth_abs_fail:
  MOVI r1,@mth_abs_bad
  CALL @mth_abs_puts
  HALT

mth_abs_puts:
  MOVI r4,255
mth_abs_puts_word:
  LD r2,r1,0
  MOVI r3,4
mth_abs_puts_byte:
  BOOL.8 r5,r2,r4
  CMP r5,r0
  RET[EQ]
  PUTC r5
  SHR r2,r2,8
  SUB r3,r3,r13
  JMP[NE] @mth_abs_puts_byte
  ADD r1,r1,r13
  JMP @mth_abs_puts_word

mth_abs_in:
.word 0x3F800000
.word 0xBF800000
.word 0x00000000
.word 0x80000000
.word 0x7FC00000
.word 0xFFC00000
.word 0x3F000000
.word 0xBF000000
