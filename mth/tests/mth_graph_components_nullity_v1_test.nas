.org 0
JMP @mth_comp_test_main
.include "../nan16/mth_graph_components_nullity_v1.nas"

mth_comp_test_main:
  MOVI r13,1
  MOVI r1,@mth_comp_offsets
  MOVI r2,@mth_comp_neighbors
  MOVI r3,8
  MOVI r4,@mth_comp_labels
  MOVI r5,@mth_comp_tmp
  MOVI r6,@mth_comp_count
  MOVI r7,@mth_comp_scratch
  CALL @mth_graph_components_nullity_v1
  CMP r1,r13
  JMP[NE] @mth_comp_fail
  MOVI r1,65
  PUTC r1

  ; Components: {0,1,2,3}, {4,5}, and 250 isolated vertices.
  ; Nullity = component count = 252.
  MOVI r6,@mth_comp_count
  LD r7,r6,0
  MOVI r8,252
  CMP r7,r8
  JMP[NE] @mth_comp_fail
  MOVI r1,66
  PUTC r1

  ; Component minima are labels 0,0,0,0,4,4,6,7,...
  MOVI r6,@mth_comp_labels
  LD r7,r6,0
  CMP r7,r0
  JMP[NE] @mth_comp_fail
  LD r7,r6,1
  CMP r7,r0
  JMP[NE] @mth_comp_fail
  LD r7,r6,2
  CMP r7,r0
  JMP[NE] @mth_comp_fail
  LD r7,r6,3
  CMP r7,r0
  JMP[NE] @mth_comp_fail
  LD r7,r6,4
  MOVI r8,4
  CMP r7,r8
  JMP[NE] @mth_comp_fail
  LD r7,r6,5
  CMP r7,r8
  JMP[NE] @mth_comp_fail
  LD r7,r6,6
  MOVI r8,6
  CMP r7,r8
  JMP[NE] @mth_comp_fail
  MOVI r1,67
  PUTC r1

  ; Empty graph has 256 singleton components.
  MOVI r1,@mth_comp_empty_offsets
  MOVI r2,@mth_comp_neighbors
  MOVI r3,0
  MOVI r4,@mth_comp_labels
  MOVI r5,@mth_comp_tmp
  MOVI r6,@mth_comp_count
  MOVI r7,@mth_comp_scratch
  CALL @mth_graph_components_nullity_v1
  CMP r1,r13
  JMP[NE] @mth_comp_fail
  MOVI r6,@mth_comp_count
  LD r7,r6,0
  MOVI r8,256
  CMP r7,r8
  JMP[NE] @mth_comp_fail
  MOVI r1,68
  PUTC r1

  MOVI r1,77
  PUTC r1
  MOVI r1,84
  PUTC r1
  MOVI r1,72
  PUTC r1
  MOVI r1,32
  PUTC r1
  MOVI r1,71
  PUTC r1
  MOVI r1,82
  PUTC r1
  MOVI r1,65
  PUTC r1
  MOVI r1,80
  PUTC r1
  MOVI r1,72
  PUTC r1
  MOVI r1,32
  PUTC r1
  MOVI r1,67
  PUTC r1
  MOVI r1,79
  PUTC r1
  MOVI r1,77
  PUTC r1
  MOVI r1,80
  PUTC r1
  MOVI r1,79
  PUTC r1
  MOVI r1,78
  PUTC r1
  MOVI r1,69
  PUTC r1
  MOVI r1,78
  PUTC r1
  MOVI r1,84
  PUTC r1
  MOVI r1,83
  PUTC r1
  MOVI r1,32
  PUTC r1
  MOVI r1,78
  PUTC r1
  MOVI r1,85
  PUTC r1
  MOVI r1,76
  PUTC r1
  MOVI r1,76
  PUTC r1
  MOVI r1,73
  PUTC r1
  MOVI r1,84
  PUTC r1
  MOVI r1,89
  PUTC r1
  MOVI r1,32
  PUTC r1
  MOVI r1,86
  PUTC r1
  MOVI r1,49
  PUTC r1
  MOVI r1,32
  PUTC r1
  MOVI r1,80
  PUTC r1
  MOVI r1,65
  PUTC r1
  MOVI r1,83
  PUTC r1
  MOVI r1,83
  PUTC r1
  MOVI r1,10
  PUTC r1
  HALT
mth_comp_fail:
  MOVI r1,70
  PUTC r1
  HALT

.org 1024
