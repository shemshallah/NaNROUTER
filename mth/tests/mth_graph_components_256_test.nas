.org 0
JMP @mth_components_test_main
.include "../nan16/mth_graph_components_256.nas"

mth_components_test_main:
  MOVI r13,1
  ; Path 0--1--2--3 plus 252 isolated vertices => 253 components.
  MOVI r1,@mth_components_path_offsets
  MOVI r2,@mth_components_path_neighbors
  MOVI r3,6
  MOVI r4,@mth_components_labels
  MOVI r5,@mth_components_parent
  CALL @mth_graph_components_256
  CMP r1,r13
  JMP[NE] @mth_components_fail
  MOVI r8,253
  CMP r2,r8
  JMP[NE] @mth_components_fail
  MOVI r6,@mth_components_labels
  LD r7,r6,0
  LD r8,r6,1
  CMP r7,r8
  JMP[NE] @mth_components_fail
  LD r8,r6,2
  CMP r7,r8
  JMP[NE] @mth_components_fail
  LD r8,r6,3
  CMP r7,r8
  JMP[NE] @mth_components_fail
  LD r8,r6,4
  MOVI r9,4
  CMP r8,r9
  JMP[NE] @mth_components_fail

  ; Two disjoint edges plus 252 isolates => 254 components.
  MOVI r1,@mth_components_disc_offsets
  MOVI r2,@mth_components_disc_neighbors
  MOVI r3,4
  MOVI r4,@mth_components_labels
  MOVI r5,@mth_components_parent
  CALL @mth_graph_components_256
  CMP r1,r13
  JMP[NE] @mth_components_fail
  MOVI r8,254
  CMP r2,r8
  JMP[NE] @mth_components_fail
  MOVI r6,@mth_components_labels
  LD r7,r6,0
  LD r8,r6,1
  CMP r7,r8
  JMP[NE] @mth_components_fail
  LD r8,r6,2
  CMP r7,r8
  JMP[EQ] @mth_components_fail
  LD r9,r6,2
  LD r10,r6,3
  CMP r9,r10
  JMP[NE] @mth_components_fail
  LD r8,r6,4
  MOVI r9,4
  CMP r8,r9
  JMP[NE] @mth_components_fail

  ; Invalid first offset rejects before output is touched.
  MOVI r6,@mth_components_disc_offsets
  MOVI r7,1
  ST r7,r6,0
  MOVI r6,@mth_components_labels
  MOVI r7,77
  ST r7,r6,0
  MOVI r1,@mth_components_disc_offsets
  MOVI r2,@mth_components_disc_neighbors
  MOVI r3,4
  MOVI r4,@mth_components_labels
  MOVI r5,@mth_components_parent
  CALL @mth_graph_components_256
  CMP r1,r0
  JMP[NE] @mth_components_fail
  MOVI r6,@mth_components_labels
  LD r7,r6,0
  MOVI r8,77
  CMP r7,r8
  JMP[NE] @mth_components_fail

  MOVI r1,@mth_components_pass
  CALL @mth_components_puts
  HALT

mth_components_fail:
  MOVI r1,@mth_components_bad
  CALL @mth_components_puts
  HALT

mth_components_puts:
  MOVI r4,255
mth_components_puts_word:
  LD r2,r1,0
  MOVI r3,4
mth_components_puts_byte:
  BOOL.8 r5,r2,r4
  CMP r5,r0
  RET[EQ]
  PUTC r5
  SHR r2,r2,8
  SUB r3,r3,r13
  JMP[NE] @mth_components_puts_byte
  ADD r1,r1,r13
  JMP @mth_components_puts_word

.org 512
