{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shemshallah/NaNROUTER/spec/math-store.schema.json",
  "title": "NaNROUTER additive math store storage contract",
  "description": "Additive math_* tables stored in the existing BS0DB/MC0DB SQLite files. A separate math_schema row owns this contract; wave_schema remains version 1 and is never reinterpreted by this layer. math_mapping is not a second job/lease authority. math_page/math_page_version are durable MC0 universe page records (0..255, with 255 reserved for NANNET0, never a lane).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "wave_schema_compatibility",
    "stores",
    "payload_chunking",
    "page_records",
    "status_enums"
  ],
  "properties": {
    "schema": {
      "const": "nanrouter.math-store.v1"
    },
    "version": {
      "const": 1
    },
    "wave_schema_compatibility": {
      "const": 1,
      "description": "wave_schema stays 1; math_schema is independent"
    },
    "stores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "BS0DB",
        "MC0DB"
      ],
      "properties": {
        "BS0DB": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "tables"
          ],
          "properties": {
            "role": {
              "const": "immutable math payloads, append-only events, certificates"
            },
            "tables": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "math_schema",
                "math_payload",
                "math_event",
                "math_certificate",
                "math_commit_evidence"
              ],
              "properties": {
                "math_schema": {
                  "$ref": "#/$defs/math_schema"
                },
                "math_payload": {
                  "$ref": "#/$defs/math_payload"
                },
                "math_event": {
                  "$ref": "#/$defs/math_event"
                },
                "math_certificate": {
                  "$ref": "#/$defs/math_certificate"
                },
                "math_commit_evidence": {
                  "$ref": "#/$defs/math_commit_evidence"
                }
              }
            }
          }
        },
        "MC0DB": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "tables"
          ],
          "properties": {
            "role": {
              "const": "current math indexes, catalog, versions, mappings, disposable preflight cache"
            },
            "tables": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "math_schema",
                "math_leaf",
                "math_leaf_version",
                "math_function",
                "math_function_version",
                "math_rule",
                "math_rule_version",
                "math_relation",
                "math_relation_version",
                "math_candidate",
                "math_admission",
                "math_nmp_packet",
                "math_nmp_transition",
                "math_mapping",
                "math_preflight_cache",
                "math_page",
                "math_page_version",
                "math_commit_intent"
              ],
              "properties": {
                "math_schema": {
                  "$ref": "#/$defs/math_schema"
                },
                "math_leaf": {
                  "$ref": "#/$defs/math_leaf"
                },
                "math_leaf_version": {
                  "$ref": "#/$defs/math_leaf_version"
                },
                "math_function": {
                  "$ref": "#/$defs/math_function"
                },
                "math_function_version": {
                  "$ref": "#/$defs/math_function_version"
                },
                "math_rule": {
                  "$ref": "#/$defs/math_rule"
                },
                "math_rule_version": {
                  "$ref": "#/$defs/math_rule_version"
                },
                "math_relation": {
                  "$ref": "#/$defs/math_relation"
                },
                "math_relation_version": {
                  "$ref": "#/$defs/math_relation_version"
                },
                "math_candidate": {
                  "$ref": "#/$defs/math_candidate"
                },
                "math_admission": {
                  "$ref": "#/$defs/math_admission"
                },
                "math_nmp_packet": {
                  "$ref": "#/$defs/math_nmp_packet"
                },
                "math_nmp_transition": {
                  "$ref": "#/$defs/math_nmp_transition"
                },
                "math_mapping": {
                  "$ref": "#/$defs/math_mapping"
                },
                "math_preflight_cache": {
                  "$ref": "#/$defs/math_preflight_cache"
                },
                "math_page": {
                  "$ref": "#/$defs/math_page"
                },
                "math_page_version": {
                  "$ref": "#/$defs/math_page_version"
                },
                "math_commit_intent": {
                  "$ref": "#/$defs/math_commit_intent"
                }
              }
            }
          }
        }
      }
    },
    "payload_chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "chunk_bytes",
        "max_payload_bytes",
        "content_addressed"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "chunk_bytes": {
          "const": 1048576
        },
        "max_payload_bytes": {
          "const": 2097152
        },
        "content_addressed": {
          "const": true
        },
        "description": {
          "const": "2 MiB math payloads are stored as 1 MiB chunks; no deployed provider blob limit is assumed"
        }
      }
    },
    "page_records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_count",
        "head_page_count",
        "nannet0_page",
        "page_bytes",
        "page_kind",
        "page_state",
        "page_map_schema",
        "page_map_digest_algorithm",
        "page_map_digest_covers",
        "pin_semantics"
      ],
      "properties": {
        "page_count": {
          "const": 256
        },
        "head_page_count": {
          "const": 255
        },
        "nannet0_page": {
          "const": 255
        },
        "page_bytes": {
          "const": 32768
        },
        "page_kind": {
          "const": [
            "head",
            "nannet0"
          ]
        },
        "page_state": {
          "const": [
            "pinned",
            "sealed",
            "evicted",
            "released",
            "quarantined"
          ]
        },
        "page_map_schema": {
          "const": "nanrouter.math-page-map.v1"
        },
        "page_map_digest_algorithm": {
          "const": "sha256 of canonical JSON with sorted keys, compact separators, ensure_ascii=false, allow_nan=false"
        },
        "page_map_digest_covers": {
          "const": [
            "page_id",
            "kind",
            "leaf_id",
            "leaf_version",
            "leaf_digest",
            "operator_id",
            "operator_version",
            "operator_digest"
          ]
        },
        "pin_semantics": {
          "const": "pins increment pin_count and generation; releases decrement and reject underflow; leaf id/version/digest binding is immutable"
        }
      }
    },
    "status_enums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "math_leaf_kind",
        "math_leaf_status",
        "math_function_status",
        "math_rule_status",
        "proof_status",
        "verdict",
        "mapping_object_type",
        "mapping_status",
        "commit_intent_state",
        "event_type",
        "nmp_state",
        "page_state",
        "page_kind"
      ],
      "properties": {
        "math_leaf_kind": {
          "const": [
            "scalar",
            "vector",
            "matrix",
            "tensor",
            "function",
            "relation",
            "rule",
            "result",
            "null",
            "void",
            "undefined",
            "unknown",
            "error",
            "hypergraph",
            "basis",
            "operator",
            "mask",
            "index",
            "proof",
            "certificate"
          ]
        },
        "math_leaf_status": {
          "const": [
            "scratch",
            "committed",
            "superseded",
            "quarantined",
            "tombstoned"
          ]
        },
        "math_function_status": {
          "const": [
            "proposed",
            "active",
            "deprecated",
            "revoked"
          ]
        },
        "math_rule_status": {
          "const": [
            "proposed",
            "validated",
            "active",
            "deprecated",
            "revoked",
            "blocked"
          ]
        },
        "proof_status": {
          "const": [
            "none",
            "stated",
            "axiom",
            "proven",
            "verified",
            "tested",
            "empirical",
            "experimental",
            "rejected"
          ]
        },
        "verdict": {
          "const": [
            "VALID",
            "INVALID",
            "UNDEFINED",
            "UNAUTHORIZED",
            "UNSUPPORTED",
            "UNAVAILABLE",
            "STALE",
            "EXPERIMENTAL",
            "UNKNOWN",
            "NULL",
            "VOID"
          ]
        },
        "mapping_object_type": {
          "const": [
            "leaf",
            "function",
            "rule",
            "relation"
          ]
        },
        "mapping_status": {
          "const": [
            "active",
            "rolled_back",
            "disabled"
          ]
        },
        "commit_intent_state": {
          "const": [
            "pending",
            "finalized",
            "failed"
          ]
        },
        "event_type": {
          "const": [
            "propose",
            "preflight",
            "execute",
            "commit",
            "null",
            "void",
            "rollback",
            "mapping",
            "admission",
            "candidate",
            "leaf",
            "function",
            "rule",
            "relation",
            "cache",
            "certificate",
            "page"
          ]
        },
        "nmp_state": {
          "const": [
            "CREATED",
            "RESOLVED",
            "CLASSIFIED",
            "PROPOSED",
            "PREFLIGHTED",
            "QUEUED",
            "EXECUTING",
            "COMPLETED",
            "COMMITTED",
            "NULL",
            "UNDEFINED",
            "REJECTED",
            "UNAVAILABLE",
            "UNAUTHORIZED",
            "STALE",
            "FAILED",
            "CANCELLED",
            "INVALID",
            "EXPERIMENTAL"
          ]
        },
        "page_state": {
          "const": [
            "pinned",
            "sealed",
            "evicted",
            "released",
            "quarantined"
          ]
        },
        "page_kind": {
          "const": [
            "head",
            "nannet0"
          ]
        }
      }
    }
  },
  "$defs": {
    "math_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "store"
          ]
        },
        "required_fields": {
          "const": [
            "store",
            "version",
            "applied_tick"
          ]
        },
        "columns": {
          "const": {
            "store": "TEXT",
            "version": "INTEGER",
            "applied_tick": "INTEGER"
          }
        },
        "constraints": {
          "const": [
            "store is BS0DB or MC0DB",
            "version is the math schema version, independent of wave_schema"
          ]
        }
      }
    },
    "math_leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "leaf_id"
          ]
        },
        "required_fields": {
          "const": [
            "leaf_id",
            "current_version",
            "generation",
            "kind",
            "type_digest",
            "status",
            "created_tick",
            "updated_tick"
          ]
        },
        "columns": {
          "const": {
            "leaf_id": "TEXT",
            "current_version": "INTEGER",
            "generation": "INTEGER",
            "kind": "TEXT",
            "type_digest": "TEXT",
            "content_digest": "TEXT",
            "status": "TEXT",
            "created_tick": "INTEGER",
            "updated_tick": "INTEGER"
          }
        },
        "nullable_fields": {
          "const": [
            "content_digest"
          ]
        },
        "digest_fields": {
          "const": [
            "type_digest",
            "content_digest"
          ]
        },
        "status_field": {
          "const": "status"
        },
        "status_enum": {
          "const": [
            "scratch",
            "committed",
            "superseded",
            "quarantined",
            "tombstoned"
          ]
        },
        "constraints": {
          "const": [
            "current_version and generation advance only by compare-and-swap",
            "a failed CAS leaves the previous current pointer active",
            "content_digest is null only for typed null/void/undefined leaves"
          ]
        }
      }
    },
    "math_leaf_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "leaf_id",
            "version"
          ]
        },
        "required_fields": {
          "const": [
            "leaf_id",
            "version",
            "leaf_digest",
            "kind",
            "type_json",
            "type_digest",
            "storage_tier",
            "leaf_json",
            "created_tick"
          ]
        },
        "columns": {
          "const": {
            "leaf_id": "TEXT",
            "version": "INTEGER",
            "leaf_digest": "TEXT",
            "kind": "TEXT",
            "type_json": "TEXT",
            "type_digest": "TEXT",
            "content_digest": "TEXT",
            "payload_ref": "TEXT",
            "storage_tier": "TEXT",
            "leaf_json": "TEXT",
            "created_tick": "INTEGER"
          }
        },
        "nullable_fields": {
          "const": [
            "content_digest",
            "payload_ref"
          ]
        },
        "digest_fields": {
          "const": [
            "leaf_digest",
            "type_digest",
            "content_digest",
            "payload_ref"
          ]
        },
        "append_only": {
          "const": true
        },
        "constraints": {
          "const": [
            "immutable: UPDATE and DELETE are rejected by triggers",
            "payload_ref addresses the canonical content in math_payload",
            "a missing or corrupt payload is a reference error, never zero/null"
          ]
        }
      }
    },
    "math_function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "function_id"
          ]
        },
        "required_fields": {
          "const": [
            "function_id",
            "current_version",
            "generation",
            "contract_digest",
            "status",
            "proof_status",
            "created_tick",
            "updated_tick"
          ]
        },
        "columns": {
          "const": {
            "function_id": "TEXT",
            "current_version": "INTEGER",
            "generation": "INTEGER",
            "contract_digest": "TEXT",
            "status": "TEXT",
            "proof_status": "TEXT",
            "created_tick": "INTEGER",
            "updated_tick": "INTEGER"
          }
        },
        "digest_fields": {
          "const": [
            "contract_digest"
          ]
        },
        "status_field": {
          "const": "status"
        },
        "status_enum": {
          "const": [
            "proposed",
            "active",
            "deprecated",
            "revoked"
          ]
        },
        "constraints": {
          "const": [
            "semantic contract identity; kernels remain implementations"
          ]
        }
      }
    },
    "math_function_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "function_id",
            "version"
          ]
        },
        "required_fields": {
          "const": [
            "function_id",
            "version",
            "contract_digest",
            "payload_ref",
            "function_json",
            "status",
            "proof_status",
            "created_tick"
          ]
        },
        "columns": {
          "const": {
            "function_id": "TEXT",
            "version": "INTEGER",
            "contract_digest": "TEXT",
            "payload_ref": "TEXT",
            "function_json": "TEXT",
            "status": "TEXT",
            "proof_status": "TEXT",
            "created_tick": "INTEGER"
          }
        },
        "digest_fields": {
          "const": [
            "contract_digest",
            "payload_ref"
          ]
        },
        "append_only": {
          "const": true
        },
        "constraints": {
          "const": [
            "immutable canonical contract and implementation bindings",
            "one function may bind multiple implementation digests"
          ]
        }
      }
    },
    "math_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "rule_id"
          ]
        },
        "required_fields": {
          "const": [
            "rule_id",
            "current_version",
            "generation",
            "level",
            "rule_digest",
            "status",
            "proof_status",
            "created_tick",
            "updated_tick"
          ]
        },
        "columns": {
          "const": {
            "rule_id": "TEXT",
            "current_version": "INTEGER",
            "generation": "INTEGER",
            "level": "INTEGER",
            "rule_digest": "TEXT",
            "status": "TEXT",
            "proof_status": "TEXT",
            "created_tick": "INTEGER",
            "updated_tick": "INTEGER"
          }
        },
        "digest_fields": {
          "const": [
            "rule_digest"
          ]
        },
        "status_field": {
          "const": "status"
        },
        "status_enum": {
          "const": [
            "proposed",
            "validated",
            "active",
            "deprecated",
            "revoked",
            "blocked"
          ]
        },
        "constraints": {
          "const": [
            "level is 0..3",
            "level-0 rules are immutable authority"
          ]
        }
      }
    },
    "math_rule_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "rule_id",
            "version"
          ]
        },
        "required_fields": {
          "const": [
            "rule_id",
            "version",
            "level",
            "rule_digest",
            "payload_ref",
            "rule_json",
            "status",
            "proof_status",
            "created_tick"
          ]
        },
        "columns": {
          "const": {
            "rule_id": "TEXT",
            "version": "INTEGER",
            "level": "INTEGER",
            "rule_digest": "TEXT",
            "payload_ref": "TEXT",
            "rule_json": "TEXT",
            "status": "TEXT",
            "proof_status": "TEXT",
            "certificate_digest": "TEXT",
            "created_tick": "INTEGER"
          }
        },
        "nullable_fields": {
          "const": [
            "certificate_digest"
          ]
        },
        "digest_fields": {
          "const": [
            "rule_digest",
            "payload_ref",
            "certificate_digest"
          ]
        },
        "append_only": {
          "const": true
        }
      }
    },
    "math_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "relation_id"
          ]
        },
        "required_fields": {
          "const": [
            "relation_id",
            "current_version",
            "generation",
            "relation_digest",
            "status",
            "created_tick",
            "updated_tick"
          ]
        },
        "columns": {
          "const": {
            "relation_id": "TEXT",
            "current_version": "INTEGER",
            "generation": "INTEGER",
            "relation_digest": "TEXT",
            "status": "TEXT",
            "created_tick": "INTEGER",
            "updated_tick": "INTEGER"
          }
        },
        "digest_fields": {
          "const": [
            "relation_digest"
          ]
        },
        "status_field": {
          "const": "status"
        },
        "status_enum": {
          "const": [
            "proposed",
            "active",
            "deprecated",
            "revoked"
          ]
        }
      }
    },
    "math_relation_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "relation_id",
            "version"
          ]
        },
        "required_fields": {
          "const": [
            "relation_id",
            "version",
            "relation_digest",
            "payload_ref",
            "relation_json",
            "created_tick"
          ]
        },
        "columns": {
          "const": {
            "relation_id": "TEXT",
            "version": "INTEGER",
            "relation_digest": "TEXT",
            "payload_ref": "TEXT",
            "relation_json": "TEXT",
            "created_tick": "INTEGER"
          }
        },
        "digest_fields": {
          "const": [
            "relation_digest",
            "payload_ref"
          ]
        },
        "append_only": {
          "const": true
        }
      }
    },
    "math_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "candidate_id"
          ]
        },
        "required_fields": {
          "const": [
            "candidate_id",
            "snapshot_id",
            "function_id",
            "function_version",
            "rank",
            "preflight_hint",
            "candidate_digest",
            "payload_ref",
            "candidate_json",
            "created_tick"
          ]
        },
        "columns": {
          "const": {
            "candidate_id": "TEXT",
            "snapshot_id": "TEXT",
            "function_id": "TEXT",
            "function_version": "INTEGER",
            "rank": "INTEGER",
            "preflight_hint": "TEXT",
            "candidate_digest": "TEXT",
            "payload_ref": "TEXT",
            "candidate_json": "TEXT",
            "created_tick": "INTEGER"
          }
        },
        "digest_fields": {
          "const": [
            "candidate_digest",
            "payload_ref"
          ]
        },
        "append_only": {
          "const": true
        },
        "constraints": {
          "const": [
            "candidate identity is content-derived and immutable"
          ]
        }
      }
    },
    "math_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_key",
        "required_fields",
        "columns"
      ],
      "properties": {
        "primary_key": {
          "const": [
            "admission_id"
          ]
        },
        "required_fields": {
          "const": [
            "admission_id",
            "candidate_id",
            "snapshot_id",
            "verdict",
            "rule_snapshot_id",
            "preflight_digest",
            "admission_digest",
            "payload_ref",
            "admission_json",
            "created_tick"
          ]
        },
        "columns": {
