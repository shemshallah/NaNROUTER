{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shemshallah/NaNROUTER/spec/learning-trigger.schema.json",
  "title": "Runner Riddle learning trigger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "learner_id",
    "requested_stage",
    "source_scope",
    "universe_id",
    "base_generation",
    "nanclock_tick",
    "acl_digest",
    "expires_at_tick",
    "nonce"
  ],
  "properties": {
    "learner_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requested_stage": {
      "enum": ["OBSERVE", "LEARN_BOOLEAN", "LEARN_ROUTING", "LANGUAGE_DEMO"]
    },
    "source_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "universe_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "base_generation": { "type": "integer", "minimum": 0 },
    "nanclock_tick": { "type": "integer", "minimum": 0 },
    "acl_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expires_at_tick": { "type": "integer", "minimum": 1 },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 128 },
    "signature": { "type": "string", "minLength": 32, "maxLength": 512 }
  }
}
