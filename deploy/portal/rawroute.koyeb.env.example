# Router-owned staging Koyeb example. Do not point at live production mounts before quiescence and backup.
# Copy these non-secret values into the Koyeb service environment.
# Each path must be an attached persistent-volume mount.
NANLM_RAWROUTE_MOUNTS={"BS0":["/bs0db"],"MC0":["/mc0db"],"SC0":["/sc0db"],"GM0":["/gm0db"]}
NANLM_RAWROUTE_REQUIRE_MOUNTS=1
NANLM_RAWROUTE_QUOTA_BYTES=9500000000
NANLM_RAWROUTE_PHYSICAL_RESERVE_BYTES=268435456
